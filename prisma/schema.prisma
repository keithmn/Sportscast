generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== AUTH =====================

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          String // ADMIN | EDITOR
  createdAt     DateTime        @default(now())
  reviewedItems MonitoredItem[]
}

// ===================== CMS / ARTICLES (Phase 1) =====================

model Author {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  bio      String?
  photoUrl String?
  articles Article[]
}

// Article-tagging taxonomy only. Underdoggs Data (a separate service) keeps
// its own independent Sport table for organizing teams/players — the two
// are kept consistent by slug convention, not a shared database, since an
// 8-row lookup list isn't worth coupling two products over.
model Sport {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  // Gates the top-level /sports.html index and its per-sport hub page —
  // every sport already has seeded articles, so "has any data" can't be
  // the signal for "ready to feature." Flipped on by hand, one sport at a
  // time, as real local league/club data lands for it (Football first).
  isActive     Boolean       @default(false)
  articles     Article[]
  competitions Competition[]
  teams        Team[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  dek           String
  body          String
  coverImageUrl String?
  sportId       String
  sport         Sport         @relation(fields: [sportId], references: [id])
  authorId      String
  author        Author        @relation(fields: [authorId], references: [id])
  tags          Tag[]
  status        String        @default("DRAFT") // DRAFT | PUBLISHED
  featured      Boolean       @default(false)
  contentType   String        @default("ARTICLE") // ARTICLE | VIDEO_POST
  // A brief is a short, fast-turnaround factual update (a signing, a fixture
  // reschedule) — it still lives in the same Archive as full features, just
  // surfaced separately via the News view so it doesn't get lost among them.
  isBrief       Boolean       @default(false)
  youtubeId     String?
  videoSeries   String?
  episodeLabel  String? // "Episode 001"
  runtimeLabel  String? // "58 min"
  // Many-to-many tags — an article can cover several competitions/clubs/
  // players at once (e.g. a relegation dispute naming six clubs). Each is
  // independent of the others: a club-tagged article doesn't need a
  // competition tag too, since the club already implies one.
  competitions  Competition[] @relation("ArticleCompetitionTags")
  clubs         Club[]        @relation("ArticleClubTags")
  players       Player[]      @relation("ArticlePlayerTags")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Set only when this article was created via the monitoring engine's
  // "promote" action (server/routes/monitoring.js) — optional, most
  // articles are still written from scratch with no monitored origin.
  monitoredFrom MonitoredItem?
  // Set only for a VIDEO_POST belonging to a show that's been upgraded to
  // a real Show/Episode record (currently just the flagship — see Show,
  // below). The 5 niche shows stay on the legacy videoSeries/episodeLabel/
  // runtimeLabel/youtubeId fields above, untouched and still functional,
  // just no longer linked from anywhere in the nav — dormant, not deleted.
  episode       Episode?
}

// ===================== SHOWS (flagship only, 2026-09-13) =====================
// Reframes the flagship from a fixed shows-data.js entry into a real data
// model — seasons, episode numbers, hosts/guests, transcripts, chapters —
// per the explicit decision to go deep on one show rather than stay
// shallow across six. The other 5 (The Hydration Break, The Ruck, Bully
// Off, Fast Break, The Circuit) are deliberately NOT modelled here: they
// keep working exactly as before via Article's legacy video fields, just
// unreferenced from shows.html/nav — dormant, not deleted, reversible
// later without a migration.
model Show {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  tagline       String
  description   String
  color         String
  coverImageUrl String?
  sportLabel    String
  isActive      Boolean   @default(true)
  seasons       Season[]
  episodes      Episode[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Season {
  id        String    @id @default(cuid())
  showId    String
  show      Show      @relation(fields: [showId], references: [id])
  number    Int
  title     String?
  startDate DateTime?
  endDate   DateTime?
  episodes  Episode[]
  createdAt DateTime  @default(now())

  @@unique([showId, number])
}

// One per flagship episode, 1:1 with the Article that actually carries the
// title/dek/body/cover/publish-state a visitor sees — Episode only holds
// the fields specific to being an episode. articleId is nullable because
// an episode could theoretically be scheduled/planned before its article
// is written, though today every Episode is created alongside its Article.
model Episode {
  id              String    @id @default(cuid())
  showId          String
  show            Show      @relation(fields: [showId], references: [id])
  seasonId        String?
  season          Season?   @relation(fields: [seasonId], references: [id])
  articleId       String?   @unique
  article         Article?  @relation(fields: [articleId], references: [id])
  episodeNumber   Int?
  host            String?
  guest           String?
  youtubeId       String?
  durationSeconds Int?
  recordingDate   DateTime?
  transcript      String?
  // Simple text blob (e.g. "00:00 Intro\n03:20 The interview begins") —
  // not a separate table. A chapter list is small and always read as a
  // whole; splitting it out would be structure this doesn't need yet.
  chapters        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ===================== SCORES & FIXTURES (football-first) =====================
// Deliberately minimal — no revived Team/Player entities (that's the separate,
// shelved data venture's job). Teams here are plain strings on each row/fixture,
// not linked records. The point is one internal shape that works whether the
// data behind it comes from a paid API (realistic for football) or manual
// newsroom entry (the only option for sports with no public feed, like rugby
// and athletics) — the same admin form and public page serve either source.
model Competition {
  id               String        @id @default(cuid())
  name             String // "Kenyan Premier League"
  slug             String        @unique
  sportId          String
  sport            Sport         @relation(fields: [sportId], references: [id])
  source           String        @default("MANUAL") // MANUAL | API | SCRAPED — how standings/fixtures are populated.
  // API = a real vendor API with a data contract (football-data.org).
  // SCRAPED = parsed from a federation's own public page, no real API
  // exists (e.g. kenyacup.co.ke) — more fragile, breaks if their HTML
  // changes; see server/jobs/syncKenyaCup.js.
  region           String        @default("KENYA") // KENYA | GLOBAL — drives Scores & Fixtures' default-open view
  category         String        @default("LEAGUE") // LEAGUE | CUP | CONTINENTAL | INTERNATIONAL — set explicitly
  // for anything that isn't a league; the default exists for migration
  // safety, not as a real fallback editors should rely on. Orthogonal to
  // `region`: region drives Kenya-expanded-vs-Global-pill display and
  // MANUAL-vs-API sourcing, category drives the Domestic/Cup/Continental/
  // International grouping on the Tables and Competitions tabs.
  externalProvider String? // "football-data.org", "kenyacup.co.ke" — null for MANUAL competitions
  externalId       String? // provider's competition code, e.g. "PL", "CL", "BL1"
  lastSyncedAt     DateTime?
  syncStatus       String? // OK | ERROR — set by the sync job, surfaced in admin only
  // Opt-in per competition — syncSquads.js derives the team list from this
  // competition's own StandingRow data (already authoritative for API
  // competitions), so no separate external id is needed here at all.
  syncSquads       Boolean       @default(false)
  standings        StandingRow[]
  fixtures         Fixture[]
  teams            Team[]
  clubs            Club[]
  articles         Article[]     @relation("ArticleCompetitionTags")

  @@unique([externalProvider, externalId])
}

model StandingRow {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  position      Int
  teamName      String
  played        Int         @default(0)
  won           Int         @default(0)
  drawn         Int         @default(0)
  lost          Int         @default(0)
  goalsFor      Int         @default(0)
  goalsAgainst  Int         @default(0)
  points        Int         @default(0)
  updatedAt     DateTime    @updatedAt
}

model Fixture {
  id              String      @id @default(cuid())
  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id])
  homeTeam        String
  awayTeam        String
  kickoff         DateTime
  originalKickoff DateTime? // set once, the first time a fixture is postponed — so "was X, now Y" can be shown, not just the new date
  homeScore       Int?
  awayScore       Int?
  status          String      @default("SCHEDULED") // SCHEDULED | LIVE | FINISHED | POSTPONED
  updatedAt       DateTime    @updatedAt

  // Lets the sync job upsert instead of wholesale delete+recreate (unlike
  // standings, blowing fixtures away every run would lose POSTPONED/manual
  // annotations) — same two teams don't play each other at the same
  // kickoff twice within one competition, manual or synced.
  @@unique([competitionId, homeTeam, awayTeam, kickoff])
}

// ===================== SHOP (Team merch — kits, sold directly per club) =====================
// Deliberately lightweight: a Team here is a shop-catalog entry, not the
// full club entity the removed "Underdoggs Data" service would have had —
// no roster, no history, just what's needed to sell kit. leagueId is
// optional/informational (which league the team plays in, for admin
// grouping) — the public sport→team toggle only needs sportId.
model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  sportId   String
  sport     Sport        @relation(fields: [sportId], references: [id])
  leagueId  String?
  league    Competition? @relation(fields: [leagueId], references: [id])
  crestUrl  String? // fixed convention: /images/teams/<slug>.jpg
  kits      Kit[]
  createdAt DateTime     @default(now())
}

// Open-ended per team — most have Home + Away, some more (a third/alternate
// kit) — label is free text, not a fixed enum, so that's just another row,
// not a special case.
model Kit {
  id             String      @id @default(cuid())
  teamId         String
  team           Team        @relation(fields: [teamId], references: [id])
  label          String // "Home" | "Away" | "Third" | ... — admin-entered, open-ended
  photoUrl       String? // nullable — same honest-empty-state pattern as Article.coverImageUrl; renders a placeholder, not fake data
  priceKesCents  Int // integer minor-unit KES — avoids float rounding, matches Flutterwave's amount handling
  sizesAvailable String? // CSV, e.g. "S,M,L,XL" — not modeled as rows in v1
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  orderItems     OrderItem[]
}

// ===================== CHECKOUT (Flutterwave — card + M-Pesa) =====================
// Dormant, not deleted (server/index.js) — the public pages this fed
// (js/cart.js and others) were themselves deleted 2026-09-13, see
// BLUEPRINT.md §27. No customer-account model — orders are guest checkout
// by name/email/phone, same precedent as Submission not requiring an
// account. Cart itself was client-side only (localStorage) — this is a
// small single-storefront catalog, not a multi-vendor cart system needing
// its own DB-backed cart model.
model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String // required for Flutterwave's M-Pesa STK push
  status          String      @default("PENDING") // PENDING | PAID | FAILED | CANCELLED
  paymentProvider String      @default("FLUTTERWAVE")
  paymentRef      String? // Flutterwave's transaction id, set once payment is confirmed
  totalKesCents   Int
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id])
  kitId             String
  kit               Kit     @relation(fields: [kitId], references: [id])
  size              String?
  quantity          Int     @default(1)
  unitPriceKesCents Int // price SNAPSHOT at order time — never re-read Kit.priceKesCents for historical totals
}

// ===================== SUBMISSIONS (Contact / Tips / Partnerships / Shop) =====================
// One shared inbox instead of four separate ones — `type` is the only thing
// that distinguishes a general contact message from a news tip, a "work with
// us" partnership inquiry, or a shop-waitlist signup.
model Submission {
  id        String   @id @default(cuid())
  type      String // CONTACT | TIP | PARTNERSHIP | SHOP_INTEREST
  name      String?
  email     String
  message   String?
  status    String   @default("NEW") // NEW | REVIEWED
  createdAt DateTime @default(now())
}

// ===================== AUDIT (Scores & Fixtures intake) =====================
// One flat log, human-readable summary rather than a full before/after
// field-diff — matches this codebase's preference for the simplest thing
// that actually works over a generic system. Written by every fixture/
// standings mutation in scores.js; read by admin/scores.html's "Recent
// Changes" panel.
model ChangeLog {
  id         String   @id @default(cuid())
  entityType String // FIXTURE | STANDINGS | COMPETITION
  entityId   String
  action     String // CREATE | UPDATE | DELETE | BULK_IMPORT
  summary    String // "Postponed Gor Mahia vs Tusker: 23 Aug → 30 Aug", "Bulk imported 18 fixtures", ...
  userName   String
  createdAt  DateTime @default(now())
}

// ===================== CANONICAL DATA LAYER LINKS (2026-09-13) =====================
// The only new shared concept between this site and the separate Underdawgs
// Sports Data platform (a different repo/database entirely — see
// BLUEPRINT.md and the "Current State & Target Architecture" audit
// artifact). One generic table, same shape as ChangeLog above, rather than
// a canonicalId column bolted onto every model that might ever need one —
// Competition/Club/Player/Fixture can all point at a canonical row this
// way without a schema change each time a new local entity type gets
// linked. Read-only from this side: Sportscast never writes back to the
// Data Platform, it just remembers which of its own rows correspond to
// which canonical one.
model CanonicalMapping {
  id                  String   @id @default(cuid())
  localEntityType     String // COMPETITION | CLUB | ...
  localId             String
  canonicalEntityType String // Competition | Team | ... (Data Platform's own model names)
  canonicalId         String // Data Platform's row id (a UUID, not a cuid — different DB, different id scheme)
  provider            String  @default("underdawgs-data")
  createdAt           DateTime @default(now())

  @@unique([localEntityType, localId, provider])
}

// ===================== CLUBS & PLAYERS (2026-08-19) =====================
// Deliberately named Club/Player, not Team — "Team" already means the
// Shop's merch catalog (Team/Kit models above), a completely different
// concept. Same MANUAL/API split as Competition: a KPL club is entered by hand
// via admin/clubs.html; a Premier League club is filled in by
// syncSquads.js. Every public page renders both identically — nothing
// downstream needs to know or care which. Standings/Fixture team names
// stay plain strings, unlinked to Club — that would be a bigger, riskier
// schema change for limited practical benefit right now; a club's name
// just needs to match the fixture spelling by convention.
model Club {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  crestUrl      String?
  venue         String?
  // The club's owner/proprietor — e.g. a chairman's name or a holding
  // group. Simple field, not a relation: there's only ever one at a time,
  // unlike Staff/Sponsors below which are real lists.
  owner         String?
  source        String      @default("MANUAL") // MANUAL | API
  externalId    String? // Wikidata QID ("Q18656") — null for MANUAL clubs
  lastSyncedAt  DateTime?
  players       Player[]
  staff         Staff[]
  sponsors      Sponsor[]
  articles      Article[]   @relation("ArticleClubTags")
  createdAt     DateTime    @default(now())
}

// The technical bench — coach, assistants, etc. Mirrors Player's shape
// closely (name/nationality/photoUrl), "role" instead of "position" since
// "Head Coach"/"Team Doctor" reads as a role, not a playing position. Only
// ever populated for Kenyan (MANUAL) clubs — see public/js/club.js, which
// is the one place this actually renders.
model Staff {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  name        String
  role        String?
  nationality String?
  photoUrl    String?
  createdAt   DateTime @default(now())
}

// A club's sponsors — a real list (shirt sponsor, kit supplier, ... can
// all be different entities), not a single field. Also Kenyan-club-only in
// practice, same as Staff.
model Sponsor {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())
}

model Player {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  name        String
  // Never regenerated after creation, even if name changes later — same
  // convention Club/Competition slugs already follow.
  slug        String    @unique
  position    String?
  nationality String?
  age         Int?
  photoUrl    String?
  externalId  String? // Wikidata QID ("Q7550600") — null for MANUAL entries
  articles    Article[] @relation("ArticlePlayerTags")
  createdAt   DateTime  @default(now())
}

// ===================== MONITORING ENGINE (2026-09-06) =====================
// An internal newsroom leads dashboard, deliberately separate from Article's
// public-facing CMS flow — see BLUEPRINT.md §11's guardrail against News
// becoming "an automated wire-scrape of third-party headlines." Nothing
// here ever reaches the public site directly: a MonitoredItem only becomes
// visible to readers once an editor explicitly promotes it into a real
// Article (still DRAFT, still theirs to rewrite) via
// server/routes/monitoring.js's /:id/promote action.
//
// Registry of things to watch — news sites, government press pages, club
// sites, YouTube channels. Same MANUAL/API/SCRAPED-style provenance
// pattern as Competition/Club above (source/externalProvider/externalId/
// lastSyncedAt/syncStatus), reused here as fetchMethod/lastFetchedAt/
// syncStatus. HTML_LIST's four selector columns are the one deviation from
// this schema's plain-scalar style forced by needing per-source config —
// kept as named columns, not a JSON blob, since nothing else in this
// schema uses JSON and a source only ever needs these four selectors.
model Source {
  id                String          @id @default(cuid())
  name              String
  category          String // NEWS | GOVERNMENT | CLUB | STADIUM_PROJECT | CAF | SOCIAL
  fetchMethod       String // RSS | HTML_LIST | YOUTUBE_CHANNEL | MANUAL
  url               String
  // HTML_LIST-only — CSS selectors for the list page. Null/unused for
  // every other fetchMethod.
  listItemSelector  String?
  titleSelector     String?
  linkSelector      String?
  dateSelector      String?
  isActive          Boolean         @default(true)
  // Per-source override, a plain cron expression string (e.g. "*/30 * * *
  // *"). Null means "use this category's default interval" — see
  // server/jobs/runMonitoringFetch.js.
  fetchIntervalCron String?
  lastFetchedAt     DateTime?
  syncStatus        String? // OK | ERROR — set by runMonitoringFetch.js
  lastError         String?
  items             MonitoredItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// One row per fetched/scraped candidate item, staged for editorial review.
model MonitoredItem {
  id               String    @id @default(cuid())
  sourceId         String
  source           Source    @relation(fields: [sourceId], references: [id])
  externalUrl      String
  title            String
  snippet          String?
  publishedAt      DateTime?
  fetchedAt        DateTime  @default(now())
  status           String    @default("NEW") // NEW | REVIEWED | PROMOTED | DISMISSED
  // AI enrichment (server/jobs/runMonitoringEnrich.js, Claude via
  // @anthropic-ai/sdk) — null until that job processes the row.
  aiSummary        String?
  aiRelevanceScore Int? // 0-100, sport-relevance specifically, calibrated per source category
  // Free-text, comma-separated AI guesses — deliberately NOT the curated
  // Tag/Sport/Competition/Club/Player relations Article uses. An editor
  // picks the real taxonomy by hand at promote time; this field is only
  // ever a provisional hint shown in the review UI.
  aiCategoryTags   String?
  promotedArticleId String?  @unique
  promotedArticle  Article?  @relation(fields: [promotedArticleId], references: [id])
  reviewedByUserId String?
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  // Lets a re-fetch of the same source upsert instead of duplicating rows,
  // without ever touching a row an editor has already reviewed/promoted —
  // same reasoning as Fixture's composite unique key above.
  @@unique([sourceId, externalUrl])
}
